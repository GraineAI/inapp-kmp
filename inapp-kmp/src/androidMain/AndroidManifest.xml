<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Hands the shared code the application at process start, so
             Graine.configure(config) needs no Android context in common code.
             Not exported; it serves no data. An app that removes it
             (tools:node="remove") calls Graine.configure(context, config). -->
        <provider
            android:name="ai.graine.inapp.kmp.GraineInitProvider"
            android:authorities="${applicationId}.graine-kmp"
            android:exported="false" />
    </application>
</manifest>
